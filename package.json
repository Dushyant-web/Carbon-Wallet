{
  "name": "carbonos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed/index.ts",
    "accounts": "tsx scripts/generate-accounts.ts",
    "reminders": "tsx --env-file-if-exists=.env scripts/reminders.ts",
    "vapid": "tsx scripts/vapid-keys.ts",
    "purge": "tsx --env-file-if-exists=.env scripts/purge.ts",
    "areas": "tsx --env-file-if-exists=.env scripts/areas.ts",
    "db:pg:schema": "node scripts/postgres-schema.mjs",
    "db:pg:migrate": "node scripts/postgres-schema.mjs && prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:pg:copy": "node scripts/postgres-schema.mjs && prisma generate --schema prisma/postgres/schema.prisma --generator pgcopy && tsx scripts/sqlite-to-postgres.ts",
    "build:netlify": "node scripts/postgres-schema.mjs && prisma generate --schema prisma/postgres/schema.prisma --generator client && prisma migrate deploy --schema prisma/postgres/schema.prisma && next build",
    "typecheck": "tsc --noEmit",
    "seed:kp2": "tsx --env-file-if-exists=.env prisma/seed/knowledgePark.ts",
    "dev:webpack": "next dev",
    "demo": "NEXT_DIST_DIR=.next-prod next build && NEXT_DIST_DIR=.next-prod next start",
    "demo:start": "NEXT_DIST_DIR=.next-prod next start",
    "seed:mohallas": "tsx --env-file=.env prisma/seed/realMohallas.ts",
    "db:ghg-backfill": "tsx --env-file=.env scripts/ghg-backfill.ts",
    "db:drop-food-waste": "tsx --env-file-if-exists=.env scripts/drop-food-waste.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.4.1",
    "@tanstack/query-sync-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "h3-js": "^4.4.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^0.477.0",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.1",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "solc": "^0.8.24",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
