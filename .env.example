DATABASE_URL="file:./dev.db"
# Admin sign-up requires this code
ADMIN_INVITE_CODE=change-me
# Demo helpers on login pages (never in production)
NEXT_PUBLIC_SHOW_DEMO=0
# Only for plain-http localhost in production mode
# COOKIE_INSECURE=1
# FastAPI engine URL used by the /py proxy
PY_API_URL=http://127.0.0.1:8001
# Shared secret between Next and the FastAPI engine
ENGINE_API_KEY=change-me
BILL_HASH_SALT=change-me
# 32-byte base64 key for encrypting uploaded bills at rest
STORAGE_KEY=change-me
# Optional: AI fallback for unclear bill photos
# ANTHROPIC_API_KEY=
# Optional: NVIDIA NIM instead (BILL_AI_PROVIDER=nvidia)
# NVIDIA_API_KEY=

# Statement salts are encrypted at rest with this 32-byte base64 key (else derived from ENGINE_API_KEY)
# ENGINE_SALT_KEY=

# Push reminders (npm run vapid makes a pair). Without them, reminders show inside the app only.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Sealing months on a public chain (contracts/deploy.py prints these). Without them: a labelled local devnet.
# CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# CHAIN_ID=80002
# CHAIN_NAME=polygon-amoy
# CHAIN_EXPLORER=https://amoy.polygonscan.com
# ANCHOR_CONTRACT_ADDRESS=
# ANCHOR_PRIVATE_KEY=
