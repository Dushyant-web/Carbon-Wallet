# Copy to .env for local work. On Netlify / Render put these in the dashboard's environment settings.
# Never commit real values. Generate secrets with:  openssl rand -base64 32

# ---------------------------------------------------------------- database
# Local: SQLite file. Production (Supabase, Mumbai region): the pooled URL (port 6543, ?pgbouncer=true) here,
# and the direct URL (port 5432) in DIRECT_URL for migrations. Build with `npm run build:netlify`.
DATABASE_URL="file:./dev.db"
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- sign-in
# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client, type "Web application").
# Authorised redirect URI: <APP_URL>/api/auth/google/callback   e.g. http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Android apps' OAuth client ids (comma-separated), accepted as ID-token audiences by /api/auth/google/idtoken
# GOOGLE_ANDROID_CLIENT_IDS=
# Public URL of the website (used for the Google redirect). Defaults to the request's own origin.
# APP_URL=https://carbon-wallet.netlify.app
# Signs the short-lived Google sign-in cookie (32+ random bytes)
AUTH_SECRET=change-me
# Platform admins who may also use Google sign-in (comma-separated). Others use password login only.
# ADMIN_EMAILS=
# Admin sign-up requires this code
ADMIN_INVITE_CODE=change-me
# Demo helpers on login pages (never in production)
NEXT_PUBLIC_SHOW_DEMO=0
# Only for plain-http localhost in production mode
# COOKIE_INSECURE=1

# ---------------------------------------------------------------- engine (Render)
# FastAPI engine URL used by the /py proxy and server-to-server calls
PY_API_URL=http://127.0.0.1:8001
# Shared secret between this server and the engine. Calls are HMAC-signed with it (src/server/engineAuth.ts);
# the engine accepts only signed calls when ENGINE_REQUIRE_SIGNATURE=1 (set on Render).
ENGINE_API_KEY=change-me
BILL_HASH_SALT=change-me

# ---------------------------------------------------------------- files
# 32-byte base64 key for encrypting uploaded bills and removal photos at rest
STORAGE_KEY=change-me
# Production: a PRIVATE Supabase Storage bucket (only ciphertext is stored there). Without these, ./storage is used.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=private-files
# Public bucket for shop product photos (create it as "public" in Supabase Storage). Without Supabase they stay in the DB.
# SUPABASE_PUBLIC_BUCKET=product-images

# ---------------------------------------------------------------- rate limits
# Shared counters across Netlify's function instances (Upstash Redis free tier). Without them: per instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- mohalla and weather
# Area totals are shown only for this many homes or more (privacy). Lower it only for a demo.
MOHALLA_MIN_HOMES=20
# Contact sent in the User-Agent to OpenStreetMap's pincode lookup (their usage policy asks for one)
# CONTACT_EMAIL=
# WEATHER_DISABLED=1

# ---------------------------------------------------------------- scheduled jobs
# POST /api/jobs/<areas|seal|ml|reminders|purge|keepalive> with "Authorization: Bearer $CRON_SECRET" (.github/workflows/jobs.yml)
# CRON_SECRET=

# ---------------------------------------------------------------- AI (Claude)
# One key switches on: Partner (the help chat), the 21 machine-translated languages, and AI reading of unclear
# bill and fuel-pump photos. Set it on Netlify (website) AND Render (engine). Without it: Partner answers from the
# help pages, other languages show English, photos are read by OCR only.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Second choice for bill / fuel photo reading (NVIDIA NIM). BILL_AI_PROVIDER / FUEL_AI_PROVIDER=nvidia force it.
# NVIDIA_API_KEY=

# ---------------------------------------------------------------- machine-learned forecast (engine)
# Where the engine keeps the trained model file (retrained nightly by the "ml" job; Render's disk is temporary,
# so it simply retrains after a restart)
# ML_MODEL_DIR=.models

# ---------------------------------------------------------------- optional
# Print every database query in the dev server's log (slow; off by default)
# PRISMA_LOG_QUERIES=1
# Statement salts are encrypted at rest with this 32-byte base64 key (else derived from ENGINE_API_KEY)
# ENGINE_SALT_KEY=
# Push notifications (npm run vapid makes a pair). Without them, reminders show inside the app only.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Sealing on a public chain (contracts/deploy.py prints these). Without them: a labelled local devnet.
# CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# CHAIN_ID=80002
# CHAIN_NAME=polygon-amoy
# CHAIN_EXPLORER=https://amoy.polygonscan.com
# ANCHOR_CONTRACT_ADDRESS=
# ANCHOR_PRIVATE_KEY=
