<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only. Debug builds override this to reach the local dev server over http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
