<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarbonWallet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Shown while the app process starts; the Compose UI replaces it on the first frame. -->
    <style name="Theme.CarbonWallet.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CarbonWallet</item>
    </style>
</resources>
